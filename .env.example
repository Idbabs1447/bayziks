# The existing DATABASE_URL is only used by the platform health endpoint.
# Bayzicks forms and pages do not use the database or add any tables.

# Set to your actual deployed origin, without a trailing slash.
SITE_URL=http://localhost:3000
# Optional absolute URL for a final social-share image. Default: generated /opengraph-image.
SOCIAL_IMAGE_URL=
# Optional confirmed Instagram profile URL. Never invent a handle.
INSTAGRAM_URL=

# Server-only Mailchimp credentials. NEVER use NEXT_PUBLIC_ prefixes for these.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
# preview explicitly validates the form without subscribing or sending any email.
# Switch to live only after configuring and testing the delivery automation.
MAILCHIMP_MODE=preview
MAILCHIMP_DELIVERY_READY=false
# Recommended: confirmation first. Set false only after reviewing consent requirements.
MAILCHIMP_DOUBLE_OPT_IN=true

# Server-only Resend email delivery for contact and collaboration forms.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
FORMS_MODE=preview

# Supplied original image, relative to public/. The component checks that it exists.
BAYZICKS_IMAGE_PATH=/images/bayzicks-digital-world.png
